<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.btownbrief.goodburlington-queue</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/sh</string>
    <string>/Users/stephendavis/btownbrief/btown-brief/scripts/open_goodburlington_queue.sh</string>
  </array>
  <!-- Once a day; if the Mac is asleep at 8:45 launchd runs it on wake. -->
  <key>StartCalendarInterval</key>
  <array>
    <dict><key>Hour</key><integer>8</integer><key>Minute</key><integer>45</integer></dict>
  </array>
  <key>StandardOutPath</key><string>/tmp/goodburlington-queue.log</string>
  <key>StandardErrorPath</key><string>/tmp/goodburlington-queue.log</string>
</dict>
</plist>
